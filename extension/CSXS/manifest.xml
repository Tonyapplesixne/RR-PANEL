<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="12.0" ExtensionBundleId="com.tonyapplesixne.rrtools" ExtensionBundleVersion="1.0.0" ExtensionBundleName="RR TOOLS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.tonyapplesixne.rrtools.panel" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[25.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.tonyapplesixne.rrtools.panel">
      <DispatchInfo Host="AEFT">
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>RR TOOLS</Menu>
          <Geometry>
            <Size>
              <Height>680</Height>
              <Width>360</Width>
            </Size>
            <MaxSize>
              <Height>2200</Height>
              <Width>1400</Width>
            </MaxSize>
            <MinSize>
              <Height>320</Height>
              <Width>280</Width>
            </MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./assets/icon-normal.png</Icon>
            <Icon Type="RollOver">./assets/icon-rollover.png</Icon>
            <Icon Type="DarkNormal">./assets/icon-dark.png</Icon>
            <Icon Type="DarkRollOver">./assets/icon-dark-rollover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
